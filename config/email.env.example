# UrbanTransit IQ — email delivery config
# COPY this file to  config/email.env  and fill it. email.env is git-ignored
# (never commit real credentials).

# ── Mode 1: REAL emails via Gmail (for actual users) ─────────────────────
# 1) Google Account → Security → 2-Step Verification: ON
# 2) https://myaccount.google.com/apppasswords → create "UrbanTransit"
# 3) Paste the 16-char App Password below (spaces are fine)
UTIQ_SMTP_USER=yourgmail@gmail.com
UTIQ_SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Mode 2: LOCAL inbox via Mailpit (offline demo) ───────────────────────
# Comment the two Gmail lines above, uncomment these, and run tools\mailpit.exe
# Inbox: http://localhost:8025
#UTIQ_SMTP_HOST=localhost
#UTIQ_SMTP_PORT=1025

# ── Mode 3: nothing filled → demo fallback ───────────────────────────────
# Codes appear on-screen + in reports/email_outbox.log. Never breaks.
