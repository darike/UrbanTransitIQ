{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{backend/__init__.py,backend/src/**,database/*.py,database/urbantransit.db,reports/*.json,reports/*.txt,parquet_data/**,raw_data/vehicles.csv}",
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,**/__pycache__/**,backend/tests/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
